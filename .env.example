ENVIRONMENT=preview

# URL pública del sitio — usada en canonicals, sitemap y OG tags.
# Cambiar al dominio definitivo cuando el propietario lo entregue.
PUBLIC_SITE_URL=https://hosterias-santa-fe.pages.dev

# Cuando sea "true" Y el dominio NO sea .pages.dev, se permite indexación.
# Dejar en "false" hasta activar el dominio definitivo.
SEO_INDEXING_ENABLED=false

PREVIEW_MODE=true

# GestionaLeads — dejar en mock hasta obtener credenciales reales
GESTIONALEADS_MODE=mock
GESTIONALEADS_API_URL=
GESTIONALEADS_API_TOKEN=
GESTIONALEADS_WORKSPACE_ID=
GESTIONALEADS_PIPELINE_ID=

# Telegram — crear bot via BotFather y añadirlo al grupo privado
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_PREVIEW=
TELEGRAM_CHAT_ID_PRODUCTION=

# WhatsApp — deshabilitado en preview
WHATSAPP_NUMBER=
WHATSAPP_ENABLED=false

# Cloudflare Turnstile — activar cuando se configuren las keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Versión del texto de consentimiento (cambiar si cambia la política)
CONSENT_VERSION=preview-1
