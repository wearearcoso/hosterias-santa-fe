# Runtime classification. Production is also inferred from non-local and *.pages.dev hosts.
ENVIRONMENT=preview
SITE_URL=http://localhost:4173
PUBLIC_SITE_URL=https://hosterias-santa-fe.pages.dev
SEO_INDEXING_ENABLED=false
PREVIEW_MODE=true

# Leads are fail-closed. There is no mock mode.
GESTIONALEADS_MODE=real
GESTIONALEADS_API_URL=
GESTIONALEADS_API_TOKEN=
GESTIONALEADS_WORKSPACE_ID=
GESTIONALEADS_PIPELINE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_PREVIEW=
TELEGRAM_CHAT_ID_PRODUCTION=

# Leave disabled until a real, approved number exists.
WHATSAPP_NUMBER=
WHATSAPP_ENABLED=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONSENT_VERSION=staging-1
